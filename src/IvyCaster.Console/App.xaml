<Application x:Class="IvyCaster.Console.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global color palette -->
            <Color x:Key="AccentColor">#A9FFAA</Color>
            <Color x:Key="SelectionBgColor">#E8FFE8</Color>
            <Color x:Key="HoverBgColor">#0A000000</Color>
            <Color x:Key="AccentTextColor">#2E7D32</Color>
            <Color x:Key="PrimaryTextColor">#1A1A1A</Color>
            <Color x:Key="SecondaryTextColor">#666666</Color>
            <Color x:Key="BorderColor">#22000000</Color>
            <Color x:Key="ChevronColor">#999999</Color>

            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SelectionBgBrush" Color="{StaticResource SelectionBgColor}" />
            <SolidColorBrush x:Key="HoverBgBrush" Color="{StaticResource HoverBgColor}" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="ChevronBrush" Color="{StaticResource ChevronColor}" />

        </ResourceDictionary>
    </Application.Resources>
</Application>
