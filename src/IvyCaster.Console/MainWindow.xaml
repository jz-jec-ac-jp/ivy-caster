<Window x:Class="IvyCaster.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ivy-caster Console"
        Height="560"
        Width="980"
        MinHeight="500"
        MinWidth="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="270" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,12"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="ivy-caster / 管理コンソール" />

        <GroupBox Grid.Row="1"
                  Grid.Column="0"
                  Header="管理対象PC"
                  Margin="0,0,12,12">
            <DataGrid x:Name="PcDataGrid"
                      Margin="8"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionChanged="PcDataGrid_OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ホスト名" Width="2*" Binding="{Binding HostName}" />
                    <DataGridTextColumn Header="IP" Width="*" Binding="{Binding IpAddress}" />
                    <DataGridTextColumn Header="OS" Width="*" Binding="{Binding OperatingSystem}" />
                    <DataGridTextColumn Header="状態" Width="*" Binding="{Binding Status}" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Grid.Column="1"
                  Header="操作"
                  Margin="0,0,0,12">
            <StackPanel Margin="8">
                <Button Height="34"
                        Margin="0,0,0,8"
                        Content="PCを再検索"
                        Click="DiscoverPcButton_OnClick" />
                <Button Height="34"
                        Margin="0,0,0,8"
                        Content="エージェント初回展開（WMI）"
                        Click="DeployAgentButton_OnClick" />
                <Button Height="34"
                        Margin="0,0,0,8"
                        Content="疎通確認"
                        Click="HeartbeatButton_OnClick" />
                <Separator Margin="0,8,0,8" />
                <TextBlock x:Name="SelectedPcTextBlock"
                           Text="選択中: なし"
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Header="実行ログ"
                  Margin="0,0,0,12">
            <TextBox x:Name="LogTextBox"
                     Margin="8"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     AcceptsReturn="True" />
        </GroupBox>

        <StatusBar Grid.Row="3"
                   Grid.Column="0"
                   Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
